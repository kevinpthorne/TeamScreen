 /**
  * Displays the 5 neighbors in what you see in the properties file.
@@ -11,5 +21,67 @@ import javax.swing.JPanel;
 public class JNeighborDisplayPanel extends JPanel{
 	
 	//private String 
+	
+	public static DefaultTableModel getTableData() {
+		try {
+			String rightData = TeamScreenDaemon.properties.getConfig().getProperty("RNeighbor");
+			String leftData = TeamScreenDaemon.properties.getConfig().getProperty("LNeighbor");
+			String topData = TeamScreenDaemon.properties.getConfig().getProperty("TNeighbor");
+			String bottomData = TeamScreenDaemon.properties.getConfig().getProperty("BNeighbor");
+			String projectorData = TeamScreenDaemon.properties.getConfig().getProperty("PNeighbor");
+			String centerData = InetAddress.getLocalHost().getHostName();
+			
+			ImageIcon rightPicture = JArrowButton.getImagefromDirection(JArrowButton.EAST);
+			ImageIcon leftPicture = JArrowButton.getImagefromDirection(JArrowButton.WEST);
+			ImageIcon topPicture = JArrowButton.getImagefromDirection(JArrowButton.NORTH);
+			ImageIcon bottomPicture = JArrowButton.getImagefromDirection(JArrowButton.SOUTH);
+			ImageIcon projectorPicture = JArrowButton.getImagefromDirection(JArrowButton.SPECIAL);
+			ImageIcon centerPicture = new ImageIcon(FolderManager.createImage("/images/computer.png", "computer"));
+			
+			JPanel rightPane = new JPanel();
+			rightPane.setLayout(new BoxLayout(rightPane, BoxLayout.PAGE_AXIS));
+			rightPane.add(new JLabel(rightPicture));
+			rightPane.add(new JLabel(rightData));
+			
+			JPanel leftPane = new JPanel();
+			leftPane.setLayout(new BoxLayout(leftPane, BoxLayout.PAGE_AXIS));
+			leftPane.add(new JLabel(leftPicture));
+			leftPane.add(new JLabel(leftData));
+			
+			JPanel topPane = new JPanel();
+			topPane.setLayout(new BoxLayout(topPane, BoxLayout.PAGE_AXIS));
+			topPane.add(new JLabel(topPicture));
+			topPane.add(new JLabel(topData));
+			
+			JPanel bottomPane = new JPanel();
+			bottomPane.setLayout(new BoxLayout(bottomPane, BoxLayout.PAGE_AXIS));
+			bottomPane.add(new JLabel(bottomPicture));
+			bottomPane.add(new JLabel(bottomData));
+			
+			JPanel projectorPane = new JPanel();
+			projectorPane.setLayout(new BoxLayout(projectorPane, BoxLayout.PAGE_AXIS));
+			projectorPane.add(new JLabel(projectorPicture));
+			projectorPane.add(new JLabel(projectorData));
+			
+			JPanel centerPane = new JPanel();
+			centerPane.setLayout(new BoxLayout(centerPane, BoxLayout.PAGE_AXIS));
+			centerPane.add(new JLabel(centerPicture));
+			centerPane.add(new JLabel(centerData));
+			
+			Object[][] data = {
+					{projectorPane, topPane, ""}, 
+					{leftPane, centerPane, rightPane},
+					{"", bottomPane, ""}
+			};
+			
+			return new DefaultTableModel(data, new String[]{"1","2","3"});
+		} catch (IOException e) {
+			e.printStackTrace();
+			return new DefaultTableModel(null, new String[]{"1","2","3"});
+		}
+		
+		
+		
+	}
 
