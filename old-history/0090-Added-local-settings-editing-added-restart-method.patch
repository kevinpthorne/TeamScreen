+			TeamScreenDaemon.getPropertiesHandler().getConfig().setProperty("NotificationLevel", 
+					String.valueOf(this.notificationLevel.getSelectedItem()));
+			TeamScreenDaemon.getPropertiesHandler().saveConfig();
+		} catch (IOException e) {
+			e.printStackTrace();
+		}
