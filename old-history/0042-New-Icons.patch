diff --git a/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/Client/ClientWindowFrame.java b/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/Client/ClientWindowFrame.java
index cda4edf..4797d9c 100644
--- a/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/Client/ClientWindowFrame.java
+++ b/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/Client/ClientWindowFrame.java
@@ -42,9 +42,9 @@ public class ClientWindowFrame extends JFrame implements RemoteControlClient {
 		this.setTitle(title + " - TeamScreen");
 		//this.setUndecorated(true);
 		this.setLayout(new BoxLayout(getContentPane(), BoxLayout.PAGE_AXIS));
-		this.setIconImage(ImageFactory.loadImage("jar://images/teamscreen.png"));
+		this.setIconImage(ImageFactory.loadImage("jar://images/TeamScreen-64px.png"));
 		
-		this.viewIcon = new ImageIcon( ImageFactory.loadImage("jar://images/teamscreen.png") );
+		this.viewIcon = new ImageIcon( ImageFactory.loadImage("jar://images/TeamScreen-64px.png") );
 		
 		this.picLabel = new JLabel(this.viewIcon);
 		add(this.picLabel);
