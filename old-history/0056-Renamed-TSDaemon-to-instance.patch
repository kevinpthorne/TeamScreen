@@ -345,7 +345,7 @@ public class TeamScreenDaemon implements KeyListener, HotkeyListener{
 		SwingUtilities.invokeLater(new Runnable() {
             @Override
             public void run() {
-                pSelect = new PushSelect(TSDaemon, window);
+                pSelect = new PushSelect(instance, window);
                 pSelect.setVisible(true);
                 windowPushed = window;
             }
@@ -356,7 +356,7 @@ public class TeamScreenDaemon implements KeyListener, HotkeyListener{
         SwingUtilities.invokeLater(new Runnable() {
             @Override
             public void run() {
-                wSelect = new WindowSelect(TSDaemon);
