 .../src/com/aptitekk/TeamScreen/TeamScreenDaemon.java  | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/TeamScreen/src/com/aptitekk/TeamScreen/TeamScreenDaemon.java b/TeamScreen/src/com/aptitekk/TeamScreen/TeamScreenDaemon.java
index b3b88c6..cb4f12e 100644
--- a/TeamScreen/src/com/aptitekk/TeamScreen/TeamScreenDaemon.java
+++ b/TeamScreen/src/com/aptitekk/TeamScreen/TeamScreenDaemon.java
@@ -60,7 +60,7 @@ public class TeamScreenDaemon implements KeyListener, HotkeyListener{
 	
 	static MainFrame frame;
 	static JFrame sframe;
-	TeamScreenDaemon TSDaemon = null;
