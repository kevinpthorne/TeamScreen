From: Kevin Thorne <kevint@aptitekk.com>
Date: Sun, 6 Apr 2014 22:20:59 -0600
Subject: [PATCH 025/101] Fixed critical bug in screen recording coordinates

---
 .../com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java   | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java b/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java
index f9316f3..ec415bf 100644
--- a/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java
+++ b/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java
@@ -44,7 +44,7 @@ public class WindowScreenRecorder extends ScreenRecorder{
 	private Rectangle getWindowRect() {
 		Point topleft = new Point(this.window.getRect()[0], this.window.getRect()[1]);
 		Point bottomright = new Point(this.window.getRect()[2], this.window.getRect()[3]);
-		return new Rectangle(topleft.x, bottomright.x, bottomright.x - topleft.x, bottomright.y - topleft.y);
+		return new Rectangle(topleft.x, topleft.y, bottomright.x - topleft.x, bottomright.y - topleft.y);
 	}
 
 	@Override
