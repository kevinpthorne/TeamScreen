diff --git a/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/Server/DynamicWindowScreenRecorder.java b/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/Server/DynamicWindowScreenRecorder.java
