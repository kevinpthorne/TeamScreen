+ *         Created Apr 6, 2014.
+ */
+public class JRCFrame extends JFrame implements RemoteControlClient {
+	
+	private JRCClient controller;
+	private ImageIcon viewIcon;
+	private boolean firstFrame = true;
+	
+	public JRCFrame(JRCClient controller) {
+		this.controller = controller;
+		
+		viewIcon = new ImageIcon( ImageFactory.loadImage("jar://images/teamscreen.png") );
+		
+		JLabel picLabel = new JLabel(viewIcon);
+		add(picLabel);
+		
+		this.setSize(picLabel.getSize());
+		this.setVisible(true);
+		this.pack();
+		this.setResizable(false);
+	}
+	
+	@Override
+	public void showNewImage(Image image) {
+		if(image==null)
