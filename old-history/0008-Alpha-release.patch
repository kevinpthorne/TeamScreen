+package com.aptitekk.TeamScreen.Net.jrc;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import com.aptitekk.TeamScreen.Net.NetHandler;
+import com.aptitekk.TeamScreen.Util.WindowInfo;
+
+/**
+ * Manages one server
+ *
+ * @author kevint.
+ *         Created Apr 6, 2014.
+ */
+@Deprecated
+public class JRCServerHandler extends Thread{
+	
+	private NetHandler netHandler;
+	JRCServerApplication server;
+	static boolean running = false;
+	
+	public JRCServerHandler(NetHandler master, WindowInfo w) {
+		this.netHandler = master;
+		this.server = new JRCServerApplication(w);
+	}
+	
+	@Override
+	public void run() {
+		try {
+			this.server.start();
+			running = true;
+			while(running) {
+				if(!this.server.isServerRunning()) {
+					running = false;
+					this.server.stop();
+					this.interrupt();
+				}
+			}
+		} catch (Exception exception) {
+			exception.printStackTrace();
+		}
+	}
+	
+	@Override
+	public void interrupt() {
+		super.interrupt();
+		
+		this.server.stop();
+		
+	}
+
+}
diff --git a/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java b/TeamScreen/src/com/aptitekk/TeamScreen/Net/jrc/WindowScreenRecorder.java
